{
  "order": 1,
  "title": "Touch Goblin",
  "tagline": "+5 whenever the box touches the exit",
  "description": "The classic: reward the event you can observe (contact) instead of the state you want (box resting inside).",
  "env": {
    "layout": "exit_pad",
    "randomize": true
  },
  "eval": [
    {
      "name": "in_distribution",
      "layout": "exit_pad",
      "episodes": 20,
      "offset": 0
    },
    {
      "name": "shifted",
      "layout": "medium",
      "episodes": 20,
      "offset": 5000
    }
  ],
  "versions": [
    {
      "version": 1,
      "title": "Touch the exit",
      "description": "Pays +5 every time the box starts touching the exit. Safe distance shaping helps the goblin find it.",
      "reward": {
        "name": "Touch the exit",
        "components": {
          "goal_entry": 5.0,
          "distance_progress": 1.0,
          "step_penalty": -0.01
        },
        "termination": {
          "on_stable": true,
          "on_hazard": true,
          "max_steps": 300
        }
      }
    },
    {
      "version": 2,
      "title": "Keep touching it",
      "description": "Patch: pay every step the box touches the exit and end the episode once it is fully inside.",
      "reward": {
        "name": "Keep touching it",
        "components": {
          "goal_contact": 0.2,
          "distance_progress": 1.0,
          "step_penalty": -0.01
        },
        "termination": {
          "on_inside": true,
          "on_stable": false,
          "on_hazard": true,
          "max_steps": 300
        }
      }
    },
    {
      "version": 3,
      "title": "Reward completion",
      "description": "Pay for the outcome: +10 once the box has rested inside for 30 frames; keep only potential-based shaping.",
      "reward": {
        "name": "Reward completion",
        "components": {
          "distance_progress": 1.0,
          "agent_box_progress": 0.3,
          "stable_goal": 10.0,
          "step_penalty": -0.01
        },
        "termination": {
          "on_stable": true,
          "on_hazard": true,
          "max_steps": 300
        }
      }
    }
  ],
  "steps": 800000,
  "seeds": [
    1,
    2,
    3
  ]
}