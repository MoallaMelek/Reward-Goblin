{
  "order": 2,
  "title": "Edge Goblin",
  "tagline": "+0.2 every step the box touches the exit",
  "description": "Contact pays every step, and the episode ends once the box is fully inside. So: never go fully inside.",
  "env": {
    "layout": "arena",
    "randomize": true
  },
  "eval": [
    {
      "name": "in_distribution",
      "layout": "arena",
      "episodes": 20,
      "offset": 0
    },
    {
      "name": "shifted",
      "layout": "medium",
      "episodes": 20,
      "offset": 5000
    }
  ],
  "steps": 800000,
  "seeds": [
    1,
    2,
    3
  ],
  "versions": [
    {
      "version": 1,
      "title": "Keep touching it",
      "description": "+0.2 every step the box overlaps the exit, distance shaping, episode ends when the box is fully inside.",
      "reward": {
        "name": "Keep touching it",
        "components": {
          "goal_contact": 0.2,
          "distance_progress": 1.0,
          "step_penalty": -0.01
        },
        "termination": {
          "on_inside": true,
          "on_stable": false,
          "on_hazard": true,
          "max_steps": 300
        }
      }
    },
    {
      "version": 2,
      "title": "Reward completion",
      "description": "Pay once for the outcome (box resting inside for 30 frames); keep only potential-based shaping.",
      "reward": {
        "name": "Reward completion",
        "components": {
          "distance_progress": 1.0,
          "agent_box_progress": 0.3,
          "stable_goal": 10.0,
          "step_penalty": -0.01
        },
        "termination": {
          "on_stable": true,
          "on_hazard": true,
          "max_steps": 300
        }
      }
    }
  ]
}