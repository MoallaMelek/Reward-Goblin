{
  "experiment": "distance_goblin",
  "version": 2,
  "title": "Signed progress + completion",
  "description": "Charge for moving away too (potential-based shaping), and pay for resting inside.",
  "reward": {
    "name": "Signed progress + completion",
    "components": {
      "distance_progress": 1.0,
      "agent_box_progress": 0.3,
      "stable_goal": 10.0,
      "step_penalty": -0.01
    },
    "termination": {
      "on_stable": true,
      "on_hazard": true,
      "max_steps": 300
    }
  },
  "env": {
    "layout": "arena",
    "randomize": true
  },
  "eval": [
    {
      "name": "in_distribution",
      "layout": "arena",
      "episodes": 20,
      "offset": 0
    },
    {
      "name": "shifted",
      "layout": "medium",
      "episodes": 20,
      "offset": 5000
    }
  ],
  "algo": {
    "name": "PPO"
  },
  "steps": 800000
}