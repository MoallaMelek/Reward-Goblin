{
  "experiment": "distance_goblin",
  "version": 1,
  "title": "Closer is better",
  "description": "Pays for every centimetre the box gets closer. Moving it away is free.",
  "reward": {
    "name": "Closer is better",
    "components": {
      "closer_bonus": 1.0
    },
    "termination": {
      "on_stable": true,
      "on_hazard": true,
      "max_steps": 300
    }
  },
  "env": {
    "layout": "arena",
    "randomize": true
  },
  "eval": [
    {
      "name": "in_distribution",
      "layout": "arena",
      "episodes": 20,
      "offset": 0
    },
    {
      "name": "shifted",
      "layout": "medium",
      "episodes": 20,
      "offset": 5000
    }
  ],
  "algo": {
    "name": "PPO"
  },
  "steps": 800000
}