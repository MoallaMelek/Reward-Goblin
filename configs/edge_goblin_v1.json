{
  "experiment": "edge_goblin",
  "version": 1,
  "title": "Keep touching it",
  "description": "+0.2 every step the box overlaps the exit, distance shaping, episode ends when the box is fully inside.",
  "reward": {
    "name": "Keep touching it",
    "components": {
      "goal_contact": 0.2,
      "distance_progress": 1.0,
      "step_penalty": -0.01
    },
    "termination": {
      "on_inside": true,
      "on_stable": false,
      "on_hazard": true,
      "max_steps": 300
    }
  },
  "env": {
    "layout": "arena",
    "randomize": true
  },
  "eval": [
    {
      "name": "in_distribution",
      "layout": "arena",
      "episodes": 20,
      "offset": 0
    },
    {
      "name": "shifted",
      "layout": "medium",
      "episodes": 20,
      "offset": 5000
    }
  ],
  "algo": {
    "name": "PPO"
  },
  "steps": 800000
}